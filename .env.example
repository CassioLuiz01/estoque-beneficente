# Copie este arquivo para .env e preencha. O .env nunca vai para o Git.

# Obrigatório. Gere com: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Deixe 0 fora do desenvolvimento: o modo debug permite executar código pelo navegador.
FLASK_DEBUG=0

# Use 1 quando o site estiver em HTTPS.
SESSION_COOKIE_SECURE=0

# Opcional: necessário só para enviar o e-mail de recuperação de senha.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
